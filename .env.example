# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Massive Financial Data API Configuration
MASSIVE_ACCESS_KEY_ID=""
MASSIVE_SECRET_ACCESS_KEY=""
MASSIVE_S3_ENDPOINT="https://files.massive.com"
MASSIVE_BUCKET="flatfiles"
MASSIVE_API_KEY=""

# Bavest API Configuration
BAVEST_API_KEY=""

# OpenRouter API Configuration
OPENROUTER_API_KEY=""

# Supabase Configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Twelve Data API Configuration
TWELVEDATA_API_KEY=""

# Finnhub API Configuration
FINNHUB_API_KEY=""

# Whop API Configuration
# Used to authenticate with Whop API v5 for digital product memberships & subscription access.
WHOP_API_KEY=""

# Core RWA Platform Persistence & Security Infrastructure (Server-Side Only)
DATABASE_URL=""
REDIS_URL=""
REDIS_HOST=""
REDIS_PORT=""
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_TLS="false"
AUTH_SECRET=""
ENCRYPTION_KEY=""
STORAGE_BUCKET=""

# External Regulated Provider Credentials (Required for Live Production)
PAYMENT_PROVIDER_KEY=""
KYC_PROVIDER_KEY=""
BLOCKCHAIN_RPC_URL=""
ANKR_MULTICHAIN_RPC_URL=""
BLOCKCHAIN_PRIVATE_KEY=""
AI_PROVIDER_KEY=""
EMAIL_PROVIDER_KEY=""
SMS_PROVIDER_KEY=""
WEBHOOK_SECRET=""

